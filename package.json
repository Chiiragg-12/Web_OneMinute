{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "native:patient:build": "vite build --mode patient --outDir dist-patient",
    "native:doctor:build": "vite build --mode doctor --outDir dist-doctor",
    "native:patient:sync:android": "npm run native:patient:build && node scripts/capacitor-target.mjs patient sync android",
    "native:doctor:sync:android": "npm run native:doctor:build && node scripts/capacitor-target.mjs doctor sync android",
    "native:patient:sync:ios": "npm run native:patient:build && node scripts/capacitor-target.mjs patient sync ios",
    "native:doctor:sync:ios": "npm run native:doctor:build && node scripts/capacitor-target.mjs doctor sync ios",
    "live:update:patient": "npm run native:patient:build && npx @capgo/cli@latest bundle upload --channel production",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capawesome/capacitor-google-sign-in": "^0.1.4",
    "@capgo/capacitor-updater": "^8.51.20",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^6.4.1",
    "vitest": "^2.1.9"
  }
}
